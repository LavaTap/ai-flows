# 项目依赖
node_modules/
dist/
.npm-cache/
*.log
.DS_Store
ai-review.config.json
.env
.ai-review-reports/
review-report.md
venv/

# 运行期日志（AI 请求日志 / 网页访问日志，本地实时写入，不入版本库）
logs/

# 构建产物：AI 美术平台前端（art/ 工程 Vite 输出，改源码后 npm run art:build 重新生成）
web/art/

# 运行时数据：SQLite 六个库（含 WAL/SHM 日志）与上传二进制，均不入版本库
# 注意：db/*.json 是 SQLite 首次导入的种子数据，仍需跟踪，勿忽略
db/*.sqlite
db/*.sqlite-wal
db/*.sqlite-shm
db/*.sqlite-journal
db/chat-uploads/
db/ticket-uploads/
db/avatars/
db/art-assets/

# 其他借用的非原创agents
.agents/skills/writing-claude-md/
.agents/skills/skill-creator/
.agents/skills/ui-ux-pro-max/

.tmp-pptx-old/
.tmp-pptx-export/
ppt/

# 采集产物（research-crawler 运行输出，统一落在 .agents/agents-output/，本地生成，不入版本库）
.agents/agents-output/
__pycache__/
*.pyc